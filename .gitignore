# Data: public/re-derivable, documented in README's "Disponibilidad de datos".
# Too large for git (raw+processed ~21GB) -- re-download from GEO/GWAS Catalog
# or regenerate via `snakemake --cores 4`.
data/

# Snakemake run metadata/cache
.snakemake/

# Logs (regenerated on every run; keep the directory via logs/.gitkeep)
logs/*.log

# renv: renv/library, local, cellar, lock, python, sandbox, staging are
# already excluded by renv/.gitignore. Keep renv.lock, renv/activate.R,
# renv/settings.json tracked so `renv::restore()` reproduces the environment.

# R
.Rhistory
.RData
.Rproj.user/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
*.swp
